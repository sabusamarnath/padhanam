# ---------------------------------------------------------------------------
# The matcher apply seam (D186/S91b). The matcher (daily_driver) and the
# optimization loop must never import each other at any layer — the neutral
# matcher_policy surface is the only thing between them (optimization writes its
# .ports on apply; the matcher reads its .ports on run via the apps bridge). The
# per-layer independence contracts below do not catch cross-LAYER leaks (e.g.
# daily_driver.application -> optimization.domain); this forbidden contract does.
# ---------------------------------------------------------------------------

[importlinter:contract:matcher-apply-seam-matcher-side]
name = Matcher apply seam: the matcher does not import optimization
type = forbidden
source_modules =
    contexts.daily_driver
forbidden_modules =
    contexts.optimization
allow_indirect_imports = false

[importlinter:contract:matcher-apply-seam-optimization-side]
name = Matcher apply seam: optimization does not import the matcher
type = forbidden
source_modules =
    contexts.optimization
forbidden_modules =
    contexts.daily_driver
allow_indirect_imports = false

# ---------------------------------------------------------------------------
# Cross-context boundary (D17). Contexts are independent at all internal
# layers. Cross-context reads go through the .api facade.
#
# The api facade is the single legal cross-context import target per D17;
# api modules legitimately re-export their own context's application use
# cases and domain value objects so callers have one stable surface.
# ignore_imports clauses below exempt the facade-internal edges (api → its
# own application/domain) from independence checks, which is what D17
# means by "the .api module is the public surface". Cross-context
# violations not mediated by api still fail.
# ---------------------------------------------------------------------------

[importlinter:contract:contexts-independent-domain]
name = Cross-context: domain layers are independent
type = independence
modules =
    contexts.inference.domain
    contexts.observability.domain
    contexts.audit.domain
    contexts.tenancy.domain
    contexts.evaluation.domain
    contexts.ingestion.domain
    contexts.methodology.domain
    contexts.agent.domain
    contexts.tools.domain
    contexts.run_history.domain
    contexts.retrieval_evaluation.domain
    contexts.optimization.domain
    contexts.portfolio.domain
    contexts.intake.domain
    contexts.messaging.domain
    contexts.intent_classification_evaluation.domain
    contexts.audit_conversation.domain
    contexts.mirror_conversation.domain
    contexts.daily_briefing.domain
    contexts.calendar.domain
    contexts.daily_driver.domain
    contexts.matcher_evaluation.domain
    contexts.matcher_policy.domain
ignore_imports =
    contexts.inference.api -> contexts.inference.domain.**
    contexts.observability.api -> contexts.observability.domain.**
    contexts.tenancy.api -> contexts.tenancy.domain.**
    contexts.tools.api -> contexts.tools.domain.**
    contexts.messaging.api -> contexts.messaging.domain.**

[importlinter:contract:contexts-independent-application]
name = Cross-context: application layers are independent
type = independence
modules =
    contexts.inference.application
    contexts.observability.application
    contexts.audit.application
    contexts.tenancy.application
    contexts.evaluation.application
    contexts.ingestion.application
    contexts.methodology.application
    contexts.agent.application
    contexts.tools.application
    contexts.run_history.application
    contexts.retrieval_evaluation.application
    contexts.optimization.application
    contexts.portfolio.application
    contexts.intake.application
    contexts.messaging.application
    contexts.intent_classification_evaluation.application
    contexts.audit_conversation.application
    contexts.mirror_conversation.application
    contexts.daily_briefing.application
    contexts.calendar.application
    contexts.daily_driver.application
    contexts.matcher_evaluation.application
    contexts.matcher_policy.application
ignore_imports =
    contexts.inference.api -> contexts.inference.application.**
    contexts.observability.api -> contexts.observability.application.**
    contexts.tenancy.api -> contexts.tenancy.application.**
    contexts.messaging.api -> contexts.messaging.application.**

[importlinter:contract:contexts-independent-adapters]
name = Cross-context: adapter trees are independent
type = independence
modules =
    contexts.inference.adapters
    contexts.observability.adapters
    contexts.audit.adapters
    contexts.tenancy.adapters
    contexts.evaluation.adapters
    contexts.ingestion.adapters
    contexts.methodology.adapters
    contexts.agent.adapters
    contexts.tools.adapters
    contexts.run_history.adapters
    contexts.retrieval_evaluation.adapters
    contexts.optimization.adapters
    contexts.portfolio.adapters
    contexts.intake.adapters
    contexts.messaging.adapters
    contexts.intent_classification_evaluation.adapters
    contexts.daily_briefing.adapters
    contexts.calendar.adapters
    contexts.daily_driver.adapters
    contexts.matcher_evaluation.adapters
    contexts.matcher_policy.adapters

# ---------------------------------------------------------------------------
# Platform isolation (D16, established in S5).
# padhanam/ cross-cutting code cannot import contexts/.
# ---------------------------------------------------------------------------

[importlinter:contract:platform-no-contexts]
name = Platform does not depend on contexts
type = forbidden
source_modules =
    padhanam
forbidden_modules =
    contexts
allow_indirect_imports = false

# ---------------------------------------------------------------------------
# Domain code is pure (extended for S7 contexts).
# Domain may not import Pydantic, vendor SDKs, or HTTP clients.
# ---------------------------------------------------------------------------

[importlinter:contract:domain-purity]
name = Domain code is pure
type = forbidden
source_modules =
    contexts.inference.domain
    contexts.observability.domain
    contexts.audit.domain
    contexts.tenancy.domain
    contexts.evaluation.domain
    contexts.ingestion.domain
    contexts.methodology.domain
    contexts.agent.domain
    contexts.tools.domain
    contexts.run_history.domain
    contexts.retrieval_evaluation.domain
    contexts.optimization.domain
    contexts.portfolio.domain
    contexts.intake.domain
    contexts.messaging.domain
    contexts.intent_classification_evaluation.domain
    contexts.calendar.domain
    contexts.daily_driver.domain
    contexts.matcher_evaluation.domain
    contexts.matcher_policy.domain
forbidden_modules =
    pydantic
    pydantic_settings
    cryptography
    jwt
    langfuse
    langgraph
    langchain
    litellm
    crewai
    openai
    anthropic
    fastapi
    httpx
    sqlalchemy
allow_indirect_imports = false

# ---------------------------------------------------------------------------
# Shared kernel is policed (Contract 2 from S5).
# ---------------------------------------------------------------------------

[importlinter:contract:shared-kernel-policed]
name = Shared kernel is framework-free
type = forbidden
source_modules =
    shared_kernel
forbidden_modules =
    pydantic
    pydantic_settings
    cryptography
    jwt
    langfuse
    langgraph
    langchain
    litellm
    crewai
    openai
    anthropic
    fastapi
