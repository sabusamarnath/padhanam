# ---------------------------------------------------------------------------
# Vendor-SDK confinement (D27, D30). Each vendor SDK enters the codebase
# only through its dedicated adapter directory. The `apps` source list
# uses allow_indirect_imports=true so apps/api/main.py may wire the
# adapter facade without seeing the SDK transitively as a violation;
# direct `import litellm` from apps still fails.
# ---------------------------------------------------------------------------

[importlinter:contract:litellm-confined]
name = litellm SDK confined to inference and ingestion outbound adapters
type = forbidden
source_modules =
    padhanam
    shared_kernel
    contexts.inference.domain
    contexts.inference.application
    contexts.inference.ports
    contexts.inference.adapters.inbound
    contexts.observability
    contexts.audit
    contexts.tenancy
    contexts.evaluation
    contexts.ingestion.domain
    contexts.ingestion.application
    contexts.ingestion.ports
    contexts.ingestion.adapters.inbound
    contexts.ingestion.adapters.outbound.parsers
    contexts.ingestion.adapters.outbound.postgres
    contexts.ingestion.adapters.outbound.neo4j
    contexts.methodology
    contexts.agent
    contexts.tools
    contexts.run_history
    contexts.retrieval_evaluation
    contexts.optimization
    contexts.portfolio
    contexts.intake
    contexts.messaging
forbidden_modules =
    litellm
allow_indirect_imports = false

[importlinter:contract:litellm-confined-apps]
name = litellm direct import forbidden in apps
type = forbidden
source_modules =
    apps
forbidden_modules =
    litellm
allow_indirect_imports = true

[importlinter:contract:langfuse-confined]
name = langfuse SDK confined to observability outbound adapter
type = forbidden
source_modules =
    padhanam
    shared_kernel
    contexts.inference
    contexts.audit
    contexts.tenancy
    contexts.evaluation
    contexts.ingestion
    contexts.methodology
    contexts.agent
    contexts.tools
    contexts.run_history
    contexts.retrieval_evaluation
    contexts.portfolio
    contexts.intake
    contexts.messaging
    contexts.observability.domain
    contexts.observability.application
    contexts.observability.ports
    contexts.observability.adapters.inbound
forbidden_modules =
    langfuse
allow_indirect_imports = false

[importlinter:contract:langfuse-confined-apps]
name = langfuse direct import forbidden in apps
type = forbidden
source_modules =
    apps
forbidden_modules =
    langfuse
allow_indirect_imports = true

[importlinter:contract:fastapi-confined]
name = fastapi confined to apps/
type = forbidden
source_modules =
    padhanam
    shared_kernel
    contexts
forbidden_modules =
    fastapi
    starlette
allow_indirect_imports = false

# ---------------------------------------------------------------------------
# S21 / D63 — neo4j SDK confined to the ingestion outbound adapter.
# The single Cypher-execution surface lives at
# ``contexts.ingestion.adapters.outbound.neo4j``; the Phase 3 Cypher
# migration runner at ``ops.migrate_neo4j`` is the only other allowed
# importer (``ops`` is not an import-linter root, so it is invisible
# to these contracts and does not require an exemption clause).
# Together with the AST enforcement test at
# ``tests/_enforcement/test_no_raw_neo4j_session.py``, the contract
# makes property-based tenant scoping defensible at audit: missing-
# predicate Cypher cannot exist in callable code because every
# Cypher path goes through the wrapper that auto-binds the
# tenant_id predicate.
# ---------------------------------------------------------------------------

[importlinter:contract:neo4j-confined]
name = neo4j SDK confined to the ingestion neo4j outbound adapter
type = forbidden
source_modules =
    padhanam
    shared_kernel
    contexts.inference
    contexts.observability
    contexts.audit
    contexts.tenancy
    contexts.evaluation
    contexts.ingestion.domain
    contexts.ingestion.application
    contexts.ingestion.ports
    contexts.ingestion.adapters.inbound
    contexts.ingestion.adapters.outbound.parsers
    contexts.ingestion.adapters.outbound.postgres
    contexts.ingestion.adapters.outbound.embedding
    contexts.methodology
    contexts.agent
    contexts.tools
    contexts.run_history
    contexts.retrieval_evaluation
    contexts.optimization
    contexts.portfolio
    contexts.intake
    contexts.messaging
forbidden_modules =
    neo4j
allow_indirect_imports = false

[importlinter:contract:neo4j-confined-apps]
name = neo4j direct import forbidden in apps
type = forbidden
source_modules =
    apps
forbidden_modules =
    neo4j
allow_indirect_imports = true

# ---------------------------------------------------------------------------
# S45 / D27, D30 — twilio SDK confined to the messaging twilio outbound
# adapter. The single place ``import twilio`` resolves to a real package is
# ``contexts.messaging.adapters.outbound.twilio``; every other module is a
# forbidden source. The LocalEcho and Postgres adapters take no Twilio
# dependency, so they are listed as forbidden sources too — this keeps the
# vendor-flexibility commitment honest (the WhatsApp channel could swap
# vendors with no change outside the twilio adapter directory). Mirrors the
# litellm / langfuse / neo4j confinement pairs.
# ---------------------------------------------------------------------------

[importlinter:contract:twilio-confined]
name = twilio SDK confined to the messaging twilio outbound adapter
type = forbidden
source_modules =
    padhanam
    shared_kernel
    contexts.inference
    contexts.observability
    contexts.audit
    contexts.tenancy
    contexts.evaluation
    contexts.ingestion
    contexts.methodology
    contexts.agent
    contexts.tools
    contexts.run_history
    contexts.retrieval_evaluation
    contexts.optimization
    contexts.portfolio
    contexts.intake
    contexts.messaging.domain
    contexts.messaging.application
    contexts.messaging.ports
    contexts.messaging.adapters.outbound.local_echo
    contexts.messaging.adapters.outbound.postgres
forbidden_modules =
    twilio
allow_indirect_imports = false

[importlinter:contract:twilio-confined-apps]
name = twilio direct import forbidden in apps
type = forbidden
source_modules =
    apps
forbidden_modules =
    twilio
allow_indirect_imports = true

# ---------------------------------------------------------------------------
# S25 / D79 — Agent context internal layers do not depend on methodology or
# ingestion. The existing cross-context independence contracts (domain /
# application / adapters) cover this implicitly through their mutual-
# independence shape; the two explicit one-way forbidden contracts below
# name the commitment specifically at the agent boundary so a reader of
# .importlinter sees the architectural shape D79 commits to: agent is the
# consumer that defines its own MethodologyLookup and SourceLookup port
# shapes (at contexts/agent/application/ports/), and the apps/cli wiring
# layer is the legitimate seam where the producer contexts' use cases get
# translated into the consumer-shaped calls. Together with the AST test
# at tests/unit/contexts/agent/test_import_isolation.py, the contracts
# guard against future drift where a developer might add an "innocent"
# cross-context type import at the consumer side.
# ---------------------------------------------------------------------------

[importlinter:contract:agent-no-methodology-internal]
name = Agent context internal layers do not depend on methodology
type = forbidden
source_modules =
    contexts.agent.domain
    contexts.agent.application
    contexts.agent.ports
forbidden_modules =
    contexts.methodology
allow_indirect_imports = false

[importlinter:contract:agent-no-ingestion-internal]
name = Agent context internal layers do not depend on ingestion
type = forbidden
source_modules =
    contexts.agent.domain
    contexts.agent.application
    contexts.agent.ports
forbidden_modules =
    contexts.ingestion
allow_indirect_imports = false
